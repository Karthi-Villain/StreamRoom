# Frontend Environment Configuration
# API Base URL for REST calls (points to FastAPI backend)
# If left empty the app uses the current origin: <origin>/api/v1
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# WebSocket Base URL for real-time room communication
# If left empty the app uses: (wss|ws)://<current host>/ws/rooms
VITE_WS_BASE_URL="ws://localhost:8000/ws/rooms"
