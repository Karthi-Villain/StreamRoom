# Production Environment Configuration
# API Base URL for REST calls (points to FastAPI backend on same domain)
VITE_API_BASE_URL="https://room.sparkxapps.in/api/v1"

# WebSocket Base URL for real-time room communication.
# Must point at the Cloudflare Tunnel that terminates directly on the uvicorn
# ASGI process (127.0.0.1:8001): LiteSpeed cannot tunnel WebSocket upgrades,
# so proxying /ws/ through the web server hangs and fails with close code 1006.
VITE_WS_BASE_URL="wss://ws.sparkxapps.in/ws/rooms"
