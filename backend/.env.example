# Project Configuration
PROJECT_NAME="Synchronized Streaming Room Backend"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database Connection String
# Default: Local SQLite database
# Example for PostgreSQL: postgresql://user:password@localhost:5432/streamroom
# Example for MySQL: mysql+pymysql://user:password@localhost:3306/streamroom
DATABASE_URL="sqlite:///./streamroom.db"

# Telemetry and WebRTC Configuration
TELEMETRY_INTERVAL_SECONDS=5
MAX_VOICE_PEERS_DEFAULT=12
PROXY_TIMEOUT_SECONDS=12.0
