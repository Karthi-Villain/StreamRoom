# ==============================================================================
# cPanel Phusion Passenger & Apache Configuration for StreamRoom
# ==============================================================================
# This .htaccess handles:
#   1. Passenger WSGI config for the FastAPI backend
#   2. Static frontend file serving from /public directory
#   3. SPA fallback routing for React Router
#   4. WebSocket upgrade proxying
#   5. Security headers and file protection
# ==============================================================================

<IfModule mod_passenger.c>
    PassengerEnabled on
    PassengerAppType python
    PassengerStartupFile passenger_wsgi.py
    PassengerAppRoot .
    PassengerPython /home/plutbfwl/virtualenv/StreamRoom/3.11/bin/python3
    # Optional: adjust node/python concurrency per hosting limits
    PassengerMinInstances 1
    PassengerMaxRequests 5000
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure Authorization headers are passed cleanly through the proxy
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ==========================================================================
    # REALTIME / API REVERSE PROXY  →  uvicorn ASGI daemon (127.0.0.1:8001)
    # ==========================================================================
    # Passenger / LiteSpeed only speak WSGI for Python apps, and WSGI has no
    # WebSocket support: every `Upgrade: websocket` request is answered with
    # 403 before FastAPI ever sees it. So /ws/* must be proxied to a real ASGI
    # server (started with `./realtime.sh start`).
    #
    # The HTTP routes are proxied to the SAME process on purpose: the room
    # state (room_manager) lives in memory, so API + WebSocket traffic must
    # hit one single process or rooms/tokens appear "not found".
    #
    # NOTE: requires mod_proxy (and mod_proxy_wstunnel for the ws:// scheme on
    # Apache; LiteSpeed handles it natively). Port must match REALTIME_PORT.
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^ws/(.*)$ ws://127.0.0.1:8001/ws/$1 [P,L]

    # If ws:// is rejected by your web server (500/403), comment the rule above
    # and enable this one instead - it upgrades the connection over plain HTTP:
    # RewriteRule ^ws/(.*)$ http://127.0.0.1:8001/ws/$1 [P,L]

    # Plain HTTP traffic to the same ASGI process (shared in-memory state)
    RewriteRule ^(api|ws|health|docs|redoc|openapi\.json)(/.*)?$ http://127.0.0.1:8001/$1$2 [P,L]

    # --- Frontend SPA: Serve static files or fallback to index.html ---
    # If the requested file exists in /public, serve it
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ /public/$1 [L]

    # If not an API route and not a real file, serve the SPA index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ /public/index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Protect database and environment files from direct HTTP access
<FilesMatch "^(\.env|\.db|streamroom\.db|passenger_wsgi\.py|run\.py|requirements\.txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Cache static assets aggressively
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
