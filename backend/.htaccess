# ==============================================================================
# cPanel Phusion Passenger & LiteSpeed Configuration for StreamRoom
# ==============================================================================

<IfModule mod_passenger.c>
    PassengerEnabled on
    PassengerAppType python
    PassengerStartupFile passenger_wsgi.py
    PassengerAppRoot /home/plutbfwl/StreamRoom
    PassengerPython /home/plutbfwl/virtualenv/StreamRoom/3.11/bin/python3
    PassengerMinInstances 1
    PassengerMaxRequests 5000
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure Authorization headers are passed cleanly
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Pass API, health, docs routes directly to Phusion Passenger
    RewriteRule ^(api|health|docs|redoc|openapi\.json)(/.*)?$ - [L]

    # Serve static assets directly if they exist on disk
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback SPA routing: serve index.html for frontend routes
    RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# Prevent caching of index.html so users always get the newest JS/CSS bundle
<FilesMatch "\.(html|htm)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# Protect database and environment files from direct HTTP access
<FilesMatch "^(\.env|\.db|streamroom\.db|passenger_wsgi\.py|run\.py|requirements\.txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Cache hashed static assets safely
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

